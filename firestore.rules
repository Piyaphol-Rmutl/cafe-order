rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // บาริสต้า = บัญชีอีเมล @barista.test (เพื่อการสาธิตบน Emulator)
    // ระบบจริงควรใช้ Custom Claims ที่ตั้งจากเซิร์ฟเวอร์ (Admin SDK)
    function isBarista() {
      return signedIn() && request.auth.token.email.matches('.*@barista[.]test');
    }

    match /orders/{orderId} {
      // ลูกค้าอ่านได้เฉพาะคำสั่งซื้อของตน บาริสต้าอ่านได้ทั้งหมด
      allow read: if isBarista()
        || (signedIn() && resource.data.uid == request.auth.uid);

      // ลูกค้าสร้างในนามตนเองเท่านั้น สถานะเริ่มต้นต้องเป็น received
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'received'
        && request.resource.data.keys()
             .hasOnly(['items', 'status', 'createdAt', 'total', 'uid', 'customer'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        // ราคามาจากแอปจึงตรวจได้แค่ชนิดและช่วงค่า ระบบจริงควรคำนวณราคาฝั่งเซิร์ฟเวอร์
        && request.resource.data.total is int
        && request.resource.data.total > 0;

      // บาริสต้าเปลี่ยนได้เฉพาะฟิลด์ status
      allow update: if isBarista()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['received', 'preparing', 'ready', 'completed'];

      allow delete: if false;
    }
  }
}
